// NZ Store — Phase 1 data model
// Мөнгөн дүн: ₮ (MNT) нь Int, Хятадын юань (CNY) нь Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  TAOBAO
  PINDUODUO
  TEMU
  WECHAT
  OTHER
}

enum PurchaseStatus {
  DRAFT        // Захиалга үүссэн, төлбөр хүлээгдэж байна
  PAID         // Marketplace дээр төлсөн
  SHIPPED      // Seller илгээсэн
  CN_WAREHOUSE // Хятад агуулахад
  IN_CARGO     // Каргод
  ARRIVED      // Монголд ирсэн
  RECEIVED     // Дэлгүүрт хүлээн авсан
}

enum PaymentMethod {
  CASH
  QPAY
  CARD
  TRANSFER
}

enum StockReason {
  PURCHASE_RECEIVE
  SALE
  ADJUST
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  platform  Platform   @default(TAOBAO)
  wechatId  String?
  note      String?
  products  Product[]
  purchases Purchase[]
  createdAt DateTime   @default(now())
}

model Product {
  id           String           @id @default(cuid())
  name         String
  nameCn       String?
  category     String?
  imageUrl     String?
  sellingPrice Int // ₮
  costCny      Decimal?         @db.Decimal(10, 2)
  platform     Platform         @default(TAOBAO)
  sourceUrl    String?
  supplierId   String?
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  variants     ProductVariant[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  color         String
  size          String
  sku           String          @unique
  stock         Int             @default(0)
  sortOrder     Int             @default(0)
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  movements     StockMovement[]
  createdAt     DateTime        @default(now())

  @@unique([productId, color, size])
}

model Purchase {
  id           String         @id @default(cuid())
  code         String         @unique // PO-0001
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  platform     Platform
  status       PurchaseStatus @default(DRAFT)
  totalCny     Decimal        @db.Decimal(12, 2)
  exchangeRate Decimal?       @db.Decimal(10, 4) // 1 CNY = ? ₮
  orderedAt    DateTime?
  note         String?
  items        PurchaseItem[]
  cargo        Cargo?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model PurchaseItem {
  id          String         @id @default(cuid())
  purchaseId  String
  purchase    Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  receivedQty Int?
  unitCostCny Decimal        @db.Decimal(10, 2)
}

model Cargo {
  id         String    @id @default(cuid())
  purchaseId String    @unique
  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  company    String?
  tracking   String?
  costMnt    Int       @default(0) // ₮
  sentAt     DateTime?
  arrivedAt  DateTime?
}

model Sale {
  id            String        @id @default(cuid())
  total         Int // ₮
  paymentMethod PaymentMethod
  soldAt        DateTime      @default(now())
  items         SaleItem[]
}

model SaleItem {
  id          String         @id @default(cuid())
  saleId      String
  sale        Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  price       Int // ₮, тухайн үеийн зарсан үнэ
  unitCostMnt Int? // landed cost, ашиг тооцоход
}

// Үлдэгдлийн өөрчлөлт бүрийн түүх (audit)
model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    StockReason
  refId     String?
  note      String?
  createdAt DateTime       @default(now())
}
